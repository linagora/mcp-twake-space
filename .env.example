# Twake Space web app
TWAKE_SPACE_URL=https://space.example.com
# As you (OIDC session token, actions approved one by one):
TWAKE_SPACE_TOKEN_COMMAND="/usr/local/bin/my-token-broker --json"
TWAKE_SPACE_OIDC_ISSUER=https://sso.example.com/
# or with a 0600 file holding a personal API token (Twake Space > Settings > API tokens):
# TWAKE_SPACE_TOKEN_FILE=/home/alice/.config/mcp-twake-space/token
# Optional
# TWAKE_SPACE_API_URL=https://space.example.com/api
USER_TIMEZONE=Europe/Paris
# TWAKE_SPACE_APPROVAL=elicit
USER_LANGUAGE=fr
