{
  "name": "mcp-twake-space",
  "version": "0.2.0",
  "description": "MCP server for Twake.ai Space: give any MCP-compatible AI assistant secure access to your team spaces, their feed (posts, polls, approvals, announcements) and the resources of each space",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-twake-space": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "twake",
    "twake.ai",
    "twake-space",
    "team",
    "feed",
    "collaboration",
    "linagora",
    "ai",
    "sovereign",
    "open-source"
  ],
  "license": "AGPL-3.0-only",
  "author": "LINAGORA <https://linagora.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linagora/mcp-twake-space.git"
  },
  "homepage": "https://github.com/linagora/mcp-twake-space#readme",
  "bugs": {
    "url": "https://github.com/linagora/mcp-twake-space/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
